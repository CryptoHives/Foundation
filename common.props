<Project>
  
  <PropertyGroup>
    <Product>CryptoHives Open Source Initiative .NET Foundation Libraries</Product>
    <RepositoryUrl>https://github.com/CryptoHives/Foundation</RepositoryUrl>
    <Copyright>Copyright © 2026 CryptoHives Open Source Initiative. All rights reserved.</Copyright>
    <PackagePrefix>CryptoHives.Foundation</PackagePrefix>
    <AssemblyPrefix>CryptoHives.Foundation</AssemblyPrefix>
    <Company>CryptoHives Open Source Initiative</Company>
    <Authors>The Keepers of the CryptoHives</Authors>
    <NoWarn>NU5125;CA2254;CA1307;CA1510;CA1512;CA1513;CS9057</NoWarn>
    <NeutralLanguage>en-US</NeutralLanguage>
    <HighEntropyVA>true</HighEntropyVA>
    <IsPackable>false</IsPackable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    <Nullable>enable</Nullable>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Highest language version supported -->
    <LangVersion>14</LangVersion>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- to check the package validation on a release build, uncomment here -->
    <!--<PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>-->
    <!-- to regenerate the compatibility suppression file, uncomment here -->
    <!--<GenerateCompatibilitySuppressionFile>true</GenerateCompatibilitySuppressionFile>-->
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAudit>true</NuGetAudit>
    <!-- Experimental algorithms are enabled by default for development and CI test builds.
         NuGet packaging pipelines must explicitly pass /p:EnableExperimentalAlgorithms=false. -->
    <EnableExperimentalAlgorithms>true</EnableExperimentalAlgorithms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableExperimentalAlgorithms)' == 'true'">
    <DefineConstants>$(DefineConstants);EXPERIMENTAL</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>
  
  <PropertyGroup>
    <PackageIcon>images/logo.jpg</PackageIcon>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <!-- MIT imposes no obligation worth an install-time prompt; requiring acceptance only adds friction. -->
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseFile>licenses/LICENSE.txt</PackageLicenseFile>
    <PackageReleaseNotes>$(RepositoryUrl)/releases</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Per-package READMEs: each project may override PackageReadmeSourceFile to point to its own README.md -->
    <PackageReadmeSourceFile Condition="'$(PackageReadmeSourceFile)' == ''">$(MSBuildThisFileDirectory)/README.md</PackageReadmeSourceFile>
    <PackageTags>CryptoHives</PackageTags>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false' AND '$(PackageLicenseExpression)' == 'MIT'">
    <None Include="$(MSBuildThisFileDirectory)/licenses/CryptoHives MIT license.txt" Pack="true" Visible="false" PackagePath="$(PackageLicenseFile)"/>
  </ItemGroup>
  
  <ItemGroup Condition="'$(IsPackable)' != 'false' AND '$(PackageLicenseExpression)' == ''">
    <None Include="$(MSBuildThisFileDirectory)/LICENSE" Pack="true" PackagePath="$(PackageLicenseFile)"/>
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)/nuget/logo.jpg" Pack="true" Visible="false" PackagePath="$(PackageIcon)"/>
  </ItemGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(PackageReadmeSourceFile)" Pack="true" Visible="false" PackagePath="$(PackageReadmeFile)"/>
  </ItemGroup>

  <ItemGroup Condition="'$(NBGV_PublicRelease)' != ''">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All"/>
  </ItemGroup>

  <!-- Deterministic build is currently not supported for code coverage tests. -->
  <PropertyGroup Condition="'$(CollectCoverage)' != 'true' AND ('$(TF_BUILD)' == 'true' OR '$(GITHUB_ACTIONS)' == 'true')">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <StrongNameKeyFile>$(MSBuildThisFileDirectory)/CryptoHives.Foundation.Key.snk</StrongNameKeyFile>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('$(StrongNameKeyFile)')">
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(StrongNameKeyFile)</AssemblyOriginatorKeyFile>
    <PublicKey>
      "002400000480000094000000060200000024000052534131000400000100010079ff8565b99f24" +
      "7c1b8461da6d8abfd37f7a34babee05d2144d3621e239dd97c51784549a7a1e5016a5a32a80cba" +
      "cecfe588452577ce462c92cd1ed7cb6641e0e376d18a5a36b876b73b2a5e57fdae91a08ca5e14c" +
      "10beb5f15fb09bf55c26d26d6dd6f315e247a6c228cacf73973cee4e6756be163f939752753bc1" +
      "cd6047dc"
    </PublicKey>
  </PropertyGroup>

  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Point at this version's notes in releases/. The file is keyed by the NuGet package version
       rather than the release tag: tags carry the fourth assembly version part that NuGet drops
       (0.6.79.4022 vs 0.6.79, see .github/workflows/test-published-packages.yml), and only the
       package version is available here - the pack step passes PackageVersion and nothing else.
       Nerdbank.GitVersioning computes it in a target, well after this file is evaluated, hence the
       deferral to pack time. Links to main, not to the tag: the notes are written and committed
       after the release is cut, so the tagged commit does not contain them. If the version is
       somehow unset, the PackageReleaseNotes fallback above keeps a working URL. -->
  <Target Name="SetVersionedReleaseNotes" BeforeTargets="GenerateNuspec">
    <PropertyGroup Condition="'$(PackageVersion)' != ''">
      <PackageReleaseNotes>$(RepositoryUrl)/blob/main/releases/$(PackageVersion).md</PackageReleaseNotes>
    </PropertyGroup>
  </Target>
</Project>

