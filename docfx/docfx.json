{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "**/*.csproj"
          ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "obj/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "googled2fe7d86cf779a1b.html",
          "7c2e1cbd9afe450880c3e3e3d0b35728.txt",
          "packages/security/cryptography/benchmark-trends/**",
          "packages/threading/benchmark-trends/**"
        ]
      }
    ],
    "output": "_site",
    "sitemap": {
      "baseUrl": "https://cryptohives.github.io/Foundation/",
      "priority": 0.5,
      "changefreq": "monthly",
      "fileOptions": {
        "index.md": {
          "priority": 1.0,
          "changefreq": "weekly"
        },
        "getting-started.md": {
          "priority": 0.8
        },
        "packages/**/index.md": {
          "priority": 0.8
        },
        "api/**": {
          "priority": 0.3
        }
      }
    },
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "CryptoHives .NET Foundation",
      "_appTitle": "CryptoHives .NET Foundation",
      "_appFooter": "© 2026 The Keepers of the CryptoHives",
      "_enableSearch": true,
      "_enableNewTab": true,
      "pdf": false
    },
    "fileMetadata": {
      "_appLogoPath": {
        "**/*": "images/logo.png"
      }
    },
    "xref": [
      "https://xref.docs.microsoft.com/query?uid={uid}"
    ]
  }
}