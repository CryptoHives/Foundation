<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Threading.Tests</AssemblyName>
    <TargetFrameworks>$(TestsTargetFrameworks)</TargetFrameworks>
    <RootNamespace>$(AssemblyName)</RootNamespace>
    <GenerateProgramFile>false</GenerateProgramFile>
    <!-- NUnit1028: The non-test method is public; AD0001: Analyzer exception -->
    <!-- The following are related to async methods that are used in tests:
      VSTHRD200: Use "Async" suffix for async methods; 
      VSTHRD103: Call async methods when in an async method; 
      VSTHRD003: Avoid awaiting foreign Tasks; 
      VSTHRD002: Avoid problematic synchronous waits 
      -->
    <NoWarn>$(NoWarn);NUnit1028;AD0001;VSTHRD200;VSTHRD103;VSTHRD003;VSTHRD002;IDE1006</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SignAssembly)' == 'true'">
    <DefineConstants>$(DefineConstants);SIGNASSEMBLY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <Compile Include="../Common/AssemblyInfo.cs" Link="Properties/AssemblyInfo.cs" />
    <Compile Include="../Common/CancellationType.cs" Link="Async/Pooled/Common/CancellationType.cs" />
    <Compile Include="../Common/Main.cs" />
    <Compile Include="../Common/Common.cs" />
    <Compile Include="../Common/ShortNameMarkdownExporter.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AsyncKeyedLock" />
    <PackageReference Include="Microsoft.VisualStudio.Threading" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net462' AND '$(TargetFramework)' != 'net48'" >
    <Compile Include="../Common/ProtoPromisesCancelationType.cs" Link="Async/Pooled/Common/ProtoPromisesCancelationType.cs" />
    <PackageReference Include="NeoSmart.AsyncLock" />
    <PackageReference Include="ProtoPromise" />
    <PackageReference Include="KeyedSemaphores" />
  </ItemGroup>

  <ItemGroup  Condition="'$(SignAssembly)' != 'true'" >
    <PackageReference Include="Nito.AsyncEx" />
    <PackageReference Include="Dao.IndividualLock" />
    <!-- Aliased: AsyncUtilities' GetAwaiter(this IEnumerable<Task>) extension is broad enough that
         unrelated code elsewhere in this project is modified. Keep it under alias.  -->
    <PackageReference Include="AsyncUtilities" Aliases="AsyncUtilitiesLib" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePackedNuGetPackages)' != 'true'">
    <ProjectReference Include="../../src/Threading/Threading.csproj" />
    <!-- Reference the analyzer project to run CHT* diagnostics during build -->
    <ProjectReference Include="../../src/Threading.Analyzers/Threading.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(UsePackedNuGetPackages)' == 'true'">
    <PackageReference Include="CryptoHives.Foundation.Threading$(_NuGetPackageSuffix)" />
    <PackageReference Include="CryptoHives.Foundation.Threading.Analyzers$(_NuGetPackageSuffix)" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties/" />
  </ItemGroup>
</Project>
