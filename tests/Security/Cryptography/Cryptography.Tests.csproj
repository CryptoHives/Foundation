<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Cryptography.Tests</AssemblyName>
    <TargetFrameworks>$(TestsTargetFrameworks)</TargetFrameworks>
    <RootNamespace>$(AssemblyName)</RootNamespace>
    <GenerateProgramFile>false</GenerateProgramFile>
    <!-- CS0618: Using obsolete SHA1Managed for testing -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="HashifyNET" />
    <PackageReference Include="NaCl.Core" />
    <PackageReference Include="OpenGost.Security.Cryptography" />
    <PackageReference Include="SauceControl.Blake2Fast" />
  </ItemGroup>

  <!-- Konscious.Security.Cryptography.Blake2 is not strong name signed -->
  <ItemGroup Condition="'$(SignAssembly)' != 'true'">
    <PackageReference Include="Konscious.Security.Cryptography.Blake2" />
  </ItemGroup>

  <PropertyGroup Condition="'$(SignAssembly)' != 'true'">
    <DefineConstants>$(DefineConstants);KONSCIOUS_BLAKE2</DefineConstants>
  </PropertyGroup>

  <!-- Exclude IndexRange transitive dependency from NaCl.Core to avoid conflict with Microsoft.Bcl.Memory on net48 -->
  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <PackageReference Include="IndexRange" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>

  <!--
    System.Text.Json is in-box from net8.0 onward and a package only on the older test legs, where
    the ACVP vector loaders use it to read the NIST JSON.
  -->
  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <!-- Blake3 NuGet packages that only support .NET 8+ and which are not strong name signed. -->
  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0')) AND '$(SignAssembly)' != 'true'">
    <PackageReference Include="Blake3" Aliases="Blake3Managed" />
    <PackageReference Include="Blake3.Native" />
    <PackageReference Include="Blake3.Managed" />
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0')) AND '$(SignAssembly)' != 'true'">
    <DefineConstants>$(DefineConstants);BLAKE3_NATIVE;BLAKE3_MANAGED;BLAKE3_DISSIMILIS</DefineConstants>
  </PropertyGroup>

  <!--
    KyberNET is an independent pure-managed ML-KEM implementation, used as a benchmark
    competitor. It targets netstandard2.1/net10.0, so it is unavailable on the net48 leg.
  -->
  <ItemGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0')) AND '$(SignAssembly)' != 'true'">
    <PackageReference Include="KyberNET" />
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0')) AND '$(SignAssembly)' != 'true'">
    <DefineConstants>$(DefineConstants);KYBERNET</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(SignAssembly)' == 'true'">
    <DefineConstants>$(DefineConstants);SIGNASSEMBLY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Common/AssemblyInfo.cs" Link="Properties/AssemblyInfo.cs" />
    <Compile Include="../../Common/Main.cs" />
    <Compile Include="../../Common/Common.cs" />
    <Compile Include="../../Common/ShortNameMarkdownExporter.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePackedNuGetPackages)' != 'true'">
    <ProjectReference Include="../../../src/Security/Cryptography/Cryptography.csproj" />
  </ItemGroup>
  
  <ItemGroup Condition="'$(UsePackedNuGetPackages)' == 'true'">
    <PackageReference Include="CryptoHives.Foundation.Security.Cryptography$(_NuGetPackageSuffix)" />
  </ItemGroup>

  <!--
    NIST ACVP conformance vectors for ML-KEM (FIPS 203), stored in NIST's own ACVP JSON schema.
    Embedded rather than inlined as C# literals: ML-KEM-1024 alone carries ~9.6 KB of hex per key
    generation case. Gzipped because the JSON is ~2 MB; MLKemAcvpVectors decompresses and parses
    it on load. Nothing is filtered — every ML-KEM group has an implementation.
    Regenerate with scripts/fetch-mlkem-acvp-vectors.py.
  -->
  <ItemGroup>
    <EmbeddedResource Include="TestData/mlkem-acvp-fips203.json.gz"
                      LogicalName="Cryptography.Tests.TestData.mlkem-acvp-fips203.json.gz" />
  </ItemGroup>

  <!--
    NIST ACVP conformance vectors for ML-DSA (FIPS 204), on the same terms. Larger than the
    ML-KEM set because ACVP messages run to several KB each and ML-DSA-87 signatures are 4.6 KB;
    ~4.4 MB of JSON gzipped to ~2.5 MB. Only the external-interface pure ML-DSA groups are kept —
    pre-hash, internal-interface and external-mu have no implementation to test yet.
    Regenerate with scripts/fetch-mldsa-acvp-vectors.py.
  -->
  <ItemGroup>
    <EmbeddedResource Include="TestData/mldsa-acvp-fips204.json.gz"
                      LogicalName="Cryptography.Tests.TestData.mldsa-acvp-fips204.json.gz" />
  </ItemGroup>

  <!--
    NIST ACVP conformance vectors for SLH-DSA (FIPS 205). Same filter as ML-DSA, but the same
    filter is not enough here: SLH-DSA signatures run from 7.8 KB to 48.7 KB, so the runnable
    set is 11.8 MB gzipped. What ships is a stratified 180-case selection (~2.15 MB) that still
    covers every parameter set. The complete 456-case file is fetched on demand: run
    scripts/fetch-slhdsa-acvp-vectors.py with the 'full' profile, and SlhDsaAcvpVectors prefers
    it when present. Regenerate with scripts/fetch-slhdsa-acvp-vectors.py.
  -->
  <ItemGroup>
    <EmbeddedResource Include="TestData/slhdsa-acvp-fips205.json.gz"
                      LogicalName="Cryptography.Tests.TestData.slhdsa-acvp-fips205.json.gz" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties/" />
  </ItemGroup>

</Project>
